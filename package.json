{
  "name": "oehtb-suite",
  "private": true,
  "type": "module",
  "description": "OEHTB-Suite: Werkzeuge (Prettier/ESLint, Drift-Check) fuer die gesamte Suite. Die drei Anwendungen (backend, handkassen, stunden) bleiben eigenstaendige npm-Projekte.",
  "scripts": {
    "lint": "eslint \"backend/src/**/*.ts\" \"stunden/backend/src/**/*.ts\" \"handkassen/backend/src/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "drift-check": "node scripts/drift-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
