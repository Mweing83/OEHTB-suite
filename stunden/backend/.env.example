# ==== Datenbank ====
DATABASE_URL="postgresql://stunden:stunden_dev_passwort@localhost:5433/stunden"

# ==== Server ====
PORT=3002

# ==== Auth / SSO ====
# WICHTIG: identischer Wert im Suite-Portal und ALLEN Tools (gemeinsames SSO)!
# Fuer die lokale Entwicklung "dev-secret" (wie im Portal und den anderen
# Tools), sonst schlaegt die SSO-Sitzungspruefung fehl.
# In Produktion kommt der Wert aus der .env im Suite-Root.
JWT_SECRET="dev-secret"
# Inaktivitaets-Timeout in Minuten
SESSION_TIMEOUT_MINUTEN=60

# ==== Suite-Integration ====
# Slug dieses Tools in der Suite-Tool-Registry.
TOOL_SLUG="stunden"
# Interne URL des Suite-Portals (fuer Rechte-Refresh). In Docker: http://portal-app:3000
SUITE_URL="http://localhost:3000"

# ==== Verschluesselung fuer gespeicherte API-Keys (at rest) ====
# Genau 32 Zeichen (256 Bit). In Produktion aendern!
ENCRYPTION_KEY="bitte32zeichenlangerschluessel!!"

# ==== Frontend-URL (CORS) ====
FRONTEND_URL="http://localhost:5174"
