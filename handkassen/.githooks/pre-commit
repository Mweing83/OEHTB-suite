#!/bin/sh
# ============================================================
#  Pre-Commit-Hook: führt vor jedem Commit die Backend-Unit-
#  Tests aus. Schlägt ein Test fehl, wird der Commit abgebrochen.
#
#  Einrichtung (einmalig pro Klon, siehe README → Tests):
#      git config core.hooksPath .githooks
#
#  Läuft NUR, wenn Backend-Dateien im Commit sind. Es werden bewusst
#  nur die schnellen Unit-Tests ausgeführt (keine Datenbank nötig);
#  die Integrationstests bleiben "npm run test:integration" vorbehalten.
# ============================================================

# Sind überhaupt Backend-Dateien im Commit? Wenn nicht: nichts zu prüfen.
if ! git diff --cached --name-only | grep -q '^backend/'; then
  exit 0
fi

# GUI-Clients (VS Code, GitHub Desktop …) starten den Hook oft mit einem
# minimalen PATH, in dem node/npm fehlen. Übliche Windows-Installationsorte
# ergänzen, falls npm nicht direkt auffindbar ist.
command -v npm >/dev/null 2>&1 || \
  PATH="$PATH:/c/Program Files/nodejs:/c/Program Files (x86)/nodejs:$HOME/AppData/Roaming/npm"

# Lässt sich npm trotzdem nicht finden, den Commit NICHT blockieren – nur warnen.
# So scheitert ein Commit ausschließlich an echten Testfehlern, nie an der
# Umgebung des Editors.
if ! command -v npm >/dev/null 2>&1; then
  echo "⚠️  npm nicht gefunden – Unit-Tests übersprungen, Commit wird zugelassen."
  echo "    Bitte die Tests bei Gelegenheit manuell ausführen:  cd backend && npm test"
  exit 0
fi

echo "Pre-Commit: Backend-Unit-Tests laufen…"
cd backend || exit 1

if ! npm test; then
  echo ""
  echo "❌  Tests fehlgeschlagen — Commit abgebrochen."
  echo "    Bitte die Fehler oben beheben und erneut committen."
  echo "    (Nur im Notfall umgehen:  git commit --no-verify)"
  exit 1
fi

echo "✅  Tests grün — Commit wird fortgesetzt."
exit 0
