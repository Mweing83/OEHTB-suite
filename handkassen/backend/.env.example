# ==== Datenbank (Entwicklung) ====
# Passt zur Dev-Datenbank aus ../docker-compose.yml (docker compose up -d).
DATABASE_URL="postgresql://handkassen:handkassen_dev_passwort@localhost:5432/handkassen"

# ==== Server ====
PORT=3001
NODE_ENV=development

# ==== Auth / SSO ====
# WICHTIG: identischer Wert im Suite-Portal und ALLEN Tools (gemeinsames SSO)!
# In Produktion kommt der Wert aus der .env im Suite-Root.
JWT_SECRET="bitte-in-produktion-aendern-langer-zufallswert"

# ==== Suite-Integration ====
# Slug dieses Tools in der Suite-Tool-Registry.
TOOL_SLUG="handkassen"
# Interne URL des Suite-Portals (fuer Rechte-Refresh). In Docker: http://portal-app:3000
SUITE_URL="http://localhost:3000"

# ==== Prisma auf Windows ARM64 (Snapdragon/Copilot+) ====
# Auf x64-Rechnern nicht noetig, schadet aber nicht.
PRISMA_CLIENT_ENGINE_TYPE=binary
PRISMA_CLI_QUERY_ENGINE_TYPE=binary
