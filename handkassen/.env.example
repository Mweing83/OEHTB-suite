# PostgreSQL
POSTGRES_USER=handkassen
POSTGRES_PASSWORD=handkassen
POSTGRES_DB=handkassen

# Backend
DATABASE_URL=postgresql://handkassen:handkassen@localhost:5432/handkassen
JWT_SECRET=bitte-durch-langen-zufallswert-ersetzen
PORT=3001
NODE_ENV=development

# Nur im Produktivbetrieb HINTER einem TLS-Reverse-Proxy oder Tailscale setzen
# (z. B. TRUST_PROXY=1). Sorgt dafür, dass Express HTTPS hinter dem Proxy erkennt
# und das `secure`-Login-Cookie korrekt sendet. OHNE Proxy weglassen/leer lassen.
# TRUST_PROXY=1

# Reiner HTTP-Betrieb im internen Netz (kein HTTPS): secure-Login-Cookie abschalten,
# sonst funktioniert die Anmeldung über http:// nicht.
# ACHTUNG: Anmeldedaten/Buchungen laufen dann UNVERSCHLÜSSELT - nur in einem
# vertrauenswürdigen, abgeschotteten Netz vertretbar. Mit HTTPS wieder leeren.
# COOKIE_INSECURE=1

# Prisma auf Windows ARM64 (Snapdragon/Copilot+). Auf x64-Servern nicht nötig.
PRISMA_CLIENT_ENGINE_TYPE=binary
PRISMA_CLI_QUERY_ENGINE_TYPE=binary

# Datensicherung (Backup-Container)
# Zeitplan, Aufbewahrung und aktive Ziele werden im Admin-Tab "Datensicherung"
# verwaltet (in der Datenbank gespeichert) – nicht hier.
# Hier nur die Ablageorte. Am Server auf die echten NAS-/USB-Pfade setzen, z. B.:
#   BACKUP_NAS=/mnt/nas/handkassen-backup
#   BACKUP_USB=/mnt/usb/handkassen-backup
BACKUP_LOKAL=./backups
BACKUP_NAS=./backups-nas
BACKUP_USB=./backups-usb
# Quelle der Belegfotos: in Produktion "belege_data" (Docker-Volume).
# Für einen lokalen Test stattdessen: BACKUP_UPLOADS_SRC=./backend/uploads
BACKUP_UPLOADS_SRC=belege_data
