# OEHTB-Suite – Produktions-Konfiguration (docker compose --profile produktion)
#
# EMPFOHLEN: NICHT von Hand ausfuellen, sondern einmalig
#   powershell -ExecutionPolicy Bypass -File .\einrichten.ps1
# ausfuehren (bzw. "SERVER - Einrichten.bat"). Das Skript erzeugt eine .env mit
# starken, URL-sicheren Zufalls-Secrets. Diese Beispieldatei dient nur zur
# Doku bzw. fuer eine manuelle Einrichtung.
#
# Die Backends verweigern in Produktion den Start, wenn ein Secret noch ein
# Platzhalter, zu kurz oder ein bekanntes Standard-Passwort ist (fail-fast).

# ==== SSO (gemeinsam fuer Portal + ALLE Tools) ====
# ZWINGEND ein langer Zufallswert (>= 32 Zeichen), identisch fuer alle Dienste.
#   z. B. erzeugen: openssl rand -base64 48
JWT_SECRET=bitte-aendern-langer-zufallswert-min-32-zeichen

# ==== User-Provisionierung (Suite -> Tools, internes Docker-Netz) ====
# Gemeinsames Geheimnis (>= 16 Zeichen), identisch fuer Portal + ALLE Tools.
# Schuetzt die internen /api/provision-Endpunkte der Tools.
#   z. B. erzeugen: openssl rand -base64 32
PROVISION_SECRET=bitte-aendern-provision-min-16-zeichen

# ==== Transport / Cookies ====
# Zugriff ueber Tailscale-HTTPS (TLS terminiert vor nginx): COOKIE_INSECURE LEER
# lassen, dann werden Session-Cookies nur ueber HTTPS gesetzt (secure-Flag).
# NUR fuer reinen HTTP-Betrieb im abgeschotteten LAN auf 1 setzen — dann werden
# die Cookies im Klartext uebertragen.
# COOKIE_INSECURE=

SESSION_TIMEOUT_MINUTEN=15

# ==== Tailscale (optionaler HTTPS-Fernzugriff) ====
# Fuer die automatische Einrichtung per "SERVER - Tailscale.bat":
# Auth-Key EINMALIG in der Tailscale-Admin-Konsole erzeugen und hier eintragen.
# Der Server tritt damit unbeaufsichtigt dem Tailnet bei. Geheim halten.
# TAILSCALE_AUTHKEY=tskey-...
# Optionaler Geraetename im Tailnet (Standard: oehtb-suite):
# TAILSCALE_HOSTNAME=oehtb-suite

# ==== Datenbanken ====
SUITE_DB_USER=suite
SUITE_DB_PASSWORD=bitte-aendern
SUITE_DB_NAME=suite

HK_DB_USER=handkassen
HK_DB_PASSWORD=bitte-aendern
HK_DB_NAME=handkassen

STUNDEN_DB_USER=stunden
STUNDEN_DB_PASSWORD=bitte-aendern
STUNDEN_DB_NAME=stunden

# Verschluesselung der im Stunden-Tool gespeicherten API-Keys (genau 32 Zeichen).
STUNDEN_ENCRYPTION_KEY=bitte-32-zeichen-schluessel-hier

FOERDERUNGEN_DB_USER=foerderungen
FOERDERUNGEN_DB_PASSWORD=bitte-aendern
FOERDERUNGEN_DB_NAME=foerderungen

# Verschluesselung der im Foerderungen-Tool gespeicherten API-Keys (genau 32 Zeichen).
FOERDERUNGEN_ENCRYPTION_KEY=bitte-32-zeichen-schluessel-hier

# ==== Handkassen-Backup-Ablageorte (echte Server-Pfade eintragen) ====
BACKUP_LOKAL=./handkassen/backups
BACKUP_NAS=./handkassen/backups-nas
BACKUP_USB=./handkassen/backups-usb
